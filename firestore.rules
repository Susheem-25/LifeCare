rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Emergency bookings accessible to authenticated emergency network roles
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }
    // Realtime telemetry stream from paramedics to ER command
    match /telemetry/{bookingId} {
      allow read, write: if request.auth != null;
    }
  }
}
