rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users can read/write user profiles
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    // Driver accounts & vehicle registrations (read, write, delete)
    match /drivers/{driverId} {
      allow read, write, delete: if request.auth != null;
    }
    // Hospital profiles, doctors, beds & machine capacity (read, write, delete)
    match /hospitals/{hospitalId} {
      allow read, write, delete: if request.auth != null;
    }
    // Emergency bookings accessible to authenticated emergency network roles
    match /bookings/{bookingId} {
      allow read, write, delete: if request.auth != null;
    }
    // Realtime telemetry stream from paramedics to ER command
    match /telemetry/{bookingId} {
      allow read, write, delete: if request.auth != null;
    }
    // Super Admin Configurations & Whitelist
    match /system_config/{configId} {
      allow read, write: if request.auth != null;
    }
    match /admins/{adminEmail} {
      allow read, write: if request.auth != null;
    }
  }
}
