rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own profile (IDOR Defense)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Public read for emergency bed availability & hospital directories
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }
    // Public read for active emergency driver network
    match /drivers/{driverId} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }
    // Emergency bookings accessible strictly to authenticated network participants
    match /bookings/{bookingId} {
      allow read, write, delete: if request.auth != null;
    }
    // Realtime vital telemetry stream between paramedics and ER trauma command
    match /telemetry/{bookingId} {
      allow read, write, delete: if request.auth != null;
    }
    // Super Admin Configurations & Whitelist
    match /system_config/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /admins/{adminEmail} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
